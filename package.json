    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "sharp": "^0.33.1",
    "openai": "^4.20.1",
    "replicate": "^0.25.2",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "execa": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/inquirer": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.3.3",
