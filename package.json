{
  "name": "ai-app-publisher",
  "version": "1.0.0",
  "description": "Automated AI-powered system for preparing and publishing React Native/Expo apps to iOS and Android stores",
  "main": "dist/index.js",
  "bin": {
    "ai-publisher": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
