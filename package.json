    "ora": "^5.4.1",
    "inquirer": "^8.2.5",
    "sharp": "^0.33.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "glob": "^10.3.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/inquirer": "^8.2.10",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.3.2",
    "tsx": "^4.6.2",
